// Equivalent compressed implementation of the adopted H0 / HA / HB likelihood.
// No ranking, labels or representations are generated by this program.
data {
  int<lower=1> N;
  int<lower=1> J;
  int<lower=1> C;
  int<lower=1> D;
  int<lower=1> Q;
  int<lower=0> H;
  int<lower=1> DS;
  int<lower=1> F;
  int<lower=0> CL;
  array[F] int<lower=1,upper=3> interaction_order;
  array[J] int<lower=1,upper=F> family;
  matrix[C,J] X_cell;
  array[N] int<lower=1,upper=C> cell;
  matrix[DS,H] slope_design;
  array[DS] int<lower=1,upper=D> slope_day;
  array[N] int<lower=1,upper=DS> slope_index;
  vector[N] chance_logit;
  matrix[N,2] baseline_basis;
  array[N] int<lower=1,upper=D> day;
  array[N] int<lower=1,upper=Q> query;
  array[N] int<lower=0,upper=CL> clip;
  array[N] int<lower=0,upper=1> hit;
  vector<lower=0>[N] likelihood_weight;
  real<lower=0> prior_scale;
  int<lower=0,upper=1> flexible_baseline;
}
transformed data {
  vector[N] y;
  for (i in 1:N) y[i]=hit[i];
}
parameters {
  real alpha;
  vector[J] z_beta;
  vector<lower=0>[F] tau;
  vector[D] z_day;
  vector[Q] z_query;
  matrix[D,H] z_slope;
  real<lower=0> sigma_day;
  real<lower=0> sigma_query;
  vector<lower=0>[H] sigma_slope;
  vector[CL] z_clip;
  real<lower=0> sigma_clip;
  vector[2] baseline_delta;
}
transformed parameters {
  vector[J] beta;
  for (j in 1:J) {
    if (interaction_order[family[j]]==1)
      beta[j]=prior_scale*0.75*z_beta[j];
    else beta[j]=prior_scale*tau[family[j]]*z_beta[j];
  }
}
model {
  vector[C] cell_eta=X_cell*beta;
  matrix[D,H] b_day=diag_post_multiply(z_slope,sigma_slope);
  vector[DS] slope_eta=rows_dot_product(slope_design,b_day[slope_day]);
  vector[N] eta=chance_logit+rep_vector(alpha,N)+cell_eta[cell]
    +sigma_day*z_day[day]+sigma_query*z_query[query]+slope_eta[slope_index];
  if (CL>0) eta+=sigma_clip*z_clip[clip];
  if (flexible_baseline==1) eta+=baseline_basis*baseline_delta;
  alpha~normal(0,1.5);
  z_beta~std_normal();
  for (f in 1:F) {
    if (interaction_order[f]==3) tau[f]~normal(0,.25);
    else tau[f]~normal(0,.5);
  }
  z_day~std_normal(); z_query~std_normal(); to_vector(z_slope)~std_normal();
  sigma_day~normal(0,1); sigma_query~normal(0,1); sigma_slope~normal(0,.5);
  z_clip~std_normal(); sigma_clip~normal(0,1);
  baseline_delta[1]~normal(0,.5); baseline_delta[2]~normal(0,.25);
  // Exact weighted Bernoulli log likelihood, stable at large |eta|.
  target+=dot_product(likelihood_weight,y .* eta-log1p_exp(eta));
}
